# Copy this file to .env and fill in your real values. Never commit .env to Git.
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.11,
ALLOWED_HOSTS = ["*"]

DB_NAME=homeservice_db
DB_USER=postgres
DB_PASSWORD=2742123
DB_HOST=localhost
DB_PORT=5432


# --- OTP / SMS ---
# 'console' = FREE, prints OTP to your terminal, use this while developing
# 'fast2sms' / 'msg91' / 'twilio' = real SMS, requires the matching keys below
SMS_BACKEND=console
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60

FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Razorpay ---
# Dashboard -> Settings -> API Keys. Use rzp_test_* keys outside production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# --- RazorpayX (payouts) ---
# Blank RAZORPAYX_ACCOUNT_NUMBER = payouts disabled.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_PAYOUT_MODE=IMPS
RAZORPAYX_VALIDATE_ACCOUNTS=True

# --- Cloudinary (image & video CDN) ---
# Dashboard -> Settings -> API Keys. CLOUD_NAME is the "Cloud name" shown at
# the top of the Cloudinary console, not your login or account name.
# Leave CLOUDINARY_CLOUD_NAME blank to store media on local disk instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
