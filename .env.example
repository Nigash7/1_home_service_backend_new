# Copy this file to .env and fill in your real values. Never commit .env to Git.
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.11,
ALLOWED_HOSTS = ["*"]

DB_NAME=homeservice_db
DB_USER=postgres
DB_PASSWORD=2742123
DB_HOST=localhost
DB_PORT=5432


# --- OTP / SMS ---
# 'console' = FREE, prints OTP to your terminal, use this while developing
# 'fast2sms' / 'msg91' / 'twilio' = real SMS, requires the matching keys below
SMS_BACKEND=console
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60

FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=